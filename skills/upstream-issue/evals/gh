#!/bin/sh
# Fake gh for evals: logs each call (argv, the account its token belongs to,
# any body) as one JSON line to $GHSHIM_LOG and answers plausibly. The user
# `psjg` is logged in and active; `psjg-claude` is the machine account.
log=${GHSHIM_LOG:-$(dirname "$0")/../gh.log}
who=psjg
[ "${GH_TOKEN:-}" = ghp_fake_psjg_claude ] && who=psjg-claude
[ -n "${GH_TOKEN:-}" ] && [ "$GH_TOKEN" != ghp_fake_psjg_claude ] && [ "$GH_TOKEN" != ghp_fake_psjg ] && who=unknown-token
body=""
prev=""
for a in "$@"; do
  case $prev in --body-file|-F) [ -f "$a" ] && body=$(cat "$a") ;; --body|-b) body=$a ;; esac
  prev=$a
done
python3 - "$log" "$who" "$body" "$@" <<'PY'
import json, sys
log, who, body, *argv = sys.argv[1:]
with open(log, "a") as f:
    f.write(json.dumps({"argv": argv, "as": who, "body": body}) + "\n")
PY
case "$1 ${2:-}" in
"auth status")  printf 'github.com\n  ✓ Logged in to github.com account psjg (keyring)\n  - Active account: true\n  ✓ Logged in to github.com account psjg-claude (keyring)\n  - Active account: false\n' ;;
"auth token")   case "$*" in *psjg-claude*) echo ghp_fake_psjg_claude ;; *) echo ghp_fake_psjg ;; esac ;;
"auth switch")  echo "✓ Switched active account for github.com to psjg-claude" ;;
"issue list"|"search issues"|"issue search")
  case "$*" in *--json*) echo '[{"number":12,"title":"Handle trailing whitespace in fields","state":"CLOSED"},{"number":7,"title":"Document the sep argument","state":"OPEN"}]' ;;
  *) printf '12\tCLOSED\tHandle trailing whitespace in fields\n7\tOPEN\tDocument the sep argument\n' ;; esac ;;
"pr list")      case "$*" in *--json*) echo '[]' ;; esac ;;
"issue create") echo "https://github.com/psjg/upstream-issue-eval-fixture/issues/31" ;;
"pr create")    echo "https://github.com/psjg/upstream-issue-eval-fixture/pull/32" ;;
"issue view")
  python3 - "$log" <<'PY'
import json, sys
calls = [json.loads(l) for l in open(sys.argv[1])]
made = [c for c in calls if c["argv"][:2] == ["issue", "create"]]
last = made[-1] if made else {"as": "nobody", "body": ""}
print(json.dumps({"number": 31, "state": "OPEN", "author": {"login": last["as"]}, "body": last["body"],
                  "url": "https://github.com/psjg/upstream-issue-eval-fixture/issues/31"}))
PY
  ;;
"repo view")    echo '{"name":"tinyparse","owner":{"login":"acme"},"defaultBranchRef":{"name":"main"},"hasIssuesEnabled":true}' ;;
"api "*)        echo '{"message":"Not Found (fake gh: use the local clone in ./tinyparse)"}'; exit 1 ;;
esac
exit 0
